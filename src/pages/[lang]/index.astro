---
import { langs, t } from '../../i18n';
export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const d = t[lang as keyof typeof t];
const app = 'https://openfarmtools.org/';
const trialUrl = 'https://openfarmtools.org/preview/#trial';
const tags = ['GPS', 'COLLAR', 'WATER', 'PLAN'];
const sIcons = [
  '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M24 5l15 6v11c0 10-6 17-15 21C15 39 9 32 9 22V11z"/><path d="M17 24l5 5 9-10"/></svg>',
  '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M24 6C16 18 12 24 12 30a12 12 0 0 0 24 0c0-6-4-12-12-24Z"/><path d="M19 31a5 5 0 0 0 5 5" opacity=".6"/></svg>',
  '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 42V21a12 12 0 0 1 24 0v21z"/><path d="M7 42h34"/><circle cx="30" cy="31" r="1.8" fill="currentColor"/></svg>',
  '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M24 43C14 31 12 25 12 20a12 12 0 0 1 24 0c0 5-2 11-12 23z"/><circle cx="24" cy="20" r="4.5"/></svg>'];
const icons = [
  '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3"><circle cx="24" cy="24" r="5" fill="currentColor"/><circle cx="24" cy="24" r="13"/><circle cx="24" cy="24" r="21" opacity=".5"/></svg>',
  '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3"><path d="M8 30a16 16 0 0 1 32 0"/><rect x="6" y="30" width="36" height="9" rx="4.5"/><circle cx="24" cy="34.5" r="2.5" fill="currentColor"/></svg>',
  '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3"><path d="M24 6C16 18 12 24 12 30a12 12 0 0 0 24 0c0-6-4-12-12-24Z"/><path d="M19 31a5 5 0 0 0 5 5" opacity=".6"/></svg>',
  '<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3"><circle cx="24" cy="24" r="17"/><path d="M24 13v11l8 5"/></svg>'];
const u = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Open Farm Tools</title>
  <link rel="icon" href={`${b}/logo.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800&family=IBM+Plex+Mono:wght@400;500&family=Cormorant+Garamond:ital,wght@1,600&display=swap" rel="stylesheet" />
</head>
<body>
  <div id="splash" role="dialog" aria-label="Welcome">
    <canvas id="bgc" aria-hidden="true"></canvas>
    <img src={u('/logo.png')} width="400" height="400" class="mark" alt="Open Farm Tools" />
    <p class="quote">“Not your keys, not your cows.”</p>
    <button id="enter" type="button" autofocus>{d.explore}</button>
    <small>{d.built}</small>
  </div>
  <nav>
    <a class="brand" href={`${b}/${lang}/`}><img src={`${b}/logo.png`} width="40" height="40" alt="" />Open Farm Tools</a>
    <a class="l" href="#products">{d.nav[0]}</a><a class="l" href="#how">{d.nav[1]}</a><a class="l" href="#pricing">{d.nav[2]}</a>
    <div class="lang">{langs.map((l) => <a href={`${b}/${l}/`} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>)}</div>
  </nav>
  <main>
    <header class="hero">
      <div>
        <h1>{d.h1}</h1><p>{d.sub}</p>
        <a class="btn solid" href="#products">{d.cta[0]}</a><a class="btn" href={app}>{d.cta[1]}</a>
      </div>
      <div class="stage" id="stage" data-t={JSON.stringify(d.map)}>
        <canvas id="c" aria-label="Interactive pasture map"></canvas>
        <div class="hint">{d.hint}</div>
        <div class="hud"><span class="pill" id="info"></span><span class="pill" id="st" aria-live="polite"></span></div>
      </div>
    </header>
    <section id="peace" class="peace"><h2>{d.peace.t}</h2><p>{d.peace.d}</p><ul class="values">{d.values.map((v) => <li>{v}</li>)}</ul></section>
    <section id="story" class="story"><h2>{d.story.t}</h2>
      <div class="storygrid">
        <figure><img src={u('/flosse.jpeg')} alt="A sheep with a hen resting on its back" loading="lazy" onerror="this.parentElement.style.display='none'" /></figure>
        <div>{d.story.i.map((x, i) => <div class="item"><div class="ico2" set:html={sIcons[i]} /><div><span class="tag">{['WATCHDOG', 'WATER', 'DOOR', 'GPS'][i]}</span><h3>{x[0]}</h3><p>{x[1]}</p></div></div>)}</div>
      </div>
    </section>
    <section id="products"><h2>{d.pt}</h2>
      <div class="pgrid">{d.p.map((x, i) => <article class="pcard"><span class="tag">{tags[i]}</span><div class="ico" set:html={icons[i]} /><h3>{x[0]}</h3><p>{x[1]}</p></article>)}</div>
      <p class="cta"><a class="btn solid" href={trialUrl}>{d.trial}</a></p>
    </section>
    <section id="how"><h2>{d.ht}</h2>
      <div class="flow" id="flow" data-s={JSON.stringify(d.s)}>
        <div class="track"><span class="dot" id="dot"></span></div>
        <div class="nodes">{d.s.map((x, i) => <button type="button" class="node" data-i={i}>{x[0]}</button>)}</div>
        <p id="cap" aria-live="polite">{d.s[0][1]}</p>
        <button type="button" class="btn solid" id="play">{d.play}</button>
      </div>
    </section>
    <section id="faq"><h2>{d.faq.t}</h2>
      <div class="faq">{d.faq.q.map((x) => <details><summary>{x[0]}</summary><p>{x[1]}</p></details>)}<p class="more">{d.faq.more}</p></div>
    </section>
    <!-- TODO: add Seb's landing page text here once it is ready (about / vision section) -->
    <section id="pricing" class="soon"><h2>{d.bt}</h2><p>{d.bd}</p><a class="btn solid" href={app}>{d.bc}</a></section>
  </main>
  <footer>{d.foot} <a class="fl" href={u('/flyer.html')}>Flyer</a></footer>
</body>
</html>

<style is:global>
  :root { --bg:#0f0d17; --card:#181526; --ink:#f3f0fa; --mute:#a59cc0; --vio:#9a5cff; --line:#2c2644; }
  * { box-sizing: border-box; }
  html, body { max-width: 100%; overflow-x: clip; }
  html { -webkit-text-size-adjust: 100%; }
  a, button, summary { touch-action: manipulation; }
  html { scroll-behavior: smooth; scroll-padding-top: 70px; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 17px/1.6 'Archivo', system-ui, sans-serif; }
  h1, h2, h3 { font-family: 'Archivo', system-ui, sans-serif; margin: 0; line-height: 1.08; }
  a:focus-visible { outline: 3px solid var(--vio); outline-offset: 3px; }
  nav { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 22px; padding: 10px 5vw; background: rgba(15,13,23,.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 10px; margin-right: auto; font: 800 19px 'Archivo', sans-serif; color: var(--ink); text-decoration: none; }
  .l { color: var(--mute); text-decoration: none; font-size: 15px; }
  .l:hover { color: var(--ink); }
  .lang { display: flex; border: 1px solid var(--line); border-radius: 99px; overflow: hidden; }
  .lang a { padding: 5px 11px; font-size: 13px; color: var(--mute); text-decoration: none; }
  .lang a[aria-current] { background: var(--vio); color: #fff; }
  .hero { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.1fr); gap: 4vw; align-items: center; padding: 7vh 5vw 9vh; min-height: 86vh; min-height: 86svh; }
  .hero h1 { font-size: clamp(40px, 6vw, 84px); font-weight: 800; letter-spacing: -.03em; }
  .hero p { color: var(--mute); max-width: 44ch; margin: 22px 0 30px; }
  .btn { display: inline-block; padding: 13px 24px; margin: 0 10px 10px 0; border: 1px solid var(--line); border-radius: 10px; color: var(--ink); text-decoration: none; font-weight: 500; }
  .btn.solid { background: var(--vio); border-color: var(--vio); color: #fff; }
  .btn:hover { filter: brightness(1.15); }
  .stage { position: relative; aspect-ratio: 1; max-height: 72vh; width: 100%; border: 1px solid var(--line); border-radius: 20px; background: radial-gradient(circle at 50% 50%, #221a3d, #120f1e 75%); overflow: hidden; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
  .hint { position: absolute; top: 14px; left: 16px; font-size: 13px; color: var(--mute); }
  .hud { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; gap: 8px; flex-wrap: wrap; font-size: 13px; }
  .pill { background: rgba(15,13,23,.92); border: 1px solid var(--line); border-radius: 10px; padding: 6px 11px; }
  section { padding: 10vh 5vw; }
  h2 { font-size: clamp(30px, 4vw, 52px); font-weight: 800; letter-spacing: -.02em; max-width: 20ch; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px,1fr)); gap: 16px; margin-top: 36px; }
  article { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  article small { color: var(--vio); font-weight: 500; }
  article h3 { font-size: 22px; margin: 10px 0 8px; }
  article p { margin: 0; color: var(--mute); font-size: 15px; }
  #splash { position: fixed; inset: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; background: var(--bg); transition: opacity .5s; }
  #splash.gone { opacity: 0; pointer-events: none; }
  #splash .quote { font: italic 600 clamp(28px, 4.8vw, 48px) 'Cormorant Garamond', Georgia, serif; margin: 0; text-align: center; padding: 0 5vw; }
  #splash button { padding: 13px 34px; border-radius: 10px; border: 1px solid var(--vio); background: var(--vio); color: #fff; font: 500 17px 'Archivo', sans-serif; cursor: pointer; }
  #splash small { position: absolute; bottom: calc(24px + env(safe-area-inset-bottom, 0px)); color: var(--mute); letter-spacing: .08em; text-transform: uppercase; font-size: 12px; }
  #splash .mark { width: min(62vw, 400px); height: auto; filter: drop-shadow(0 0 18px rgba(255,255,255,.5)) drop-shadow(0 0 48px rgba(154,92,255,.7)); animation: rise 1.1s ease-out both, glow 3.2s ease-in-out 1.1s infinite; }
  #splash .quote { animation: fade 1s ease-out .9s both; }
  #splash button { animation: fade 1s ease-out 1.5s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px) scale(.92); } to { opacity: 1; transform: none; } }
  @keyframes glow { 50% { filter: drop-shadow(0 0 26px rgba(255,255,255,.8)) drop-shadow(0 0 70px rgba(154,92,255,.95)); } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { #splash .mark, #splash .quote, #splash button { animation: none; } }
  .peace { background: linear-gradient(135deg, #2a1659, #1a1030); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .peace p { font-size: clamp(19px, 2.2vw, 26px); max-width: 52ch; margin: 22px 0 0; color: var(--ink); }
  .peace h2 { color: #c9b0ff; }
  article:hover { border-color: var(--vio); box-shadow: 0 0 30px rgba(154,92,255,.22); }
  .values { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; padding: 0; margin: 28px 0 0; }
  .values li { border: 1px solid var(--vio); border-radius: 99px; padding: 6px 16px; font-size: 15px; color: #d9c8ff; }
  .flow { margin-top: 48px; text-align: center; }
  .track { position: relative; height: 4px; margin: 28px 16.666% 0; background: var(--line); border-radius: 4px; }
  .dot { position: absolute; top: 50%; left: 0; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; background: #fff; box-shadow: 0 0 20px 6px rgba(154,92,255,.8); transition: left 1s ease-in-out; }
  .nodes { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: -14px; }
  .node { position: relative; background: none; border: 0; color: var(--mute); font: 600 18px 'Archivo', sans-serif; cursor: pointer; padding: 40px 8px 0; }
  .node::before { content: ''; position: absolute; top: 0; left: 50%; width: 28px; height: 28px; margin-left: -14px; border-radius: 50%; border: 3px solid var(--vio); background: var(--bg); transition: background .3s, box-shadow .3s; }
  .node.on { color: var(--ink); }
  .node.on::before { background: var(--vio); box-shadow: 0 0 18px rgba(154,92,255,.9); }
  #cap { min-height: 3.4em; max-width: 52ch; margin: 22px auto; color: var(--ink); }
  #play:disabled { opacity: .6; }
  @media (prefers-reduced-motion: reduce) { .dot { transition: none; } }
  .pgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 40px; }
  .pcard { position: relative; overflow: hidden; padding: 30px 26px 32px; border-radius: 22px; border: 1px solid var(--line); background: linear-gradient(160deg, #241a42, #14111f); transition: transform .25s, border-color .25s, box-shadow .25s; --x: 50%; --y: 0%; }
  .pcard::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(240px circle at var(--x) var(--y), rgba(154,92,255,.28), transparent 70%); opacity: 0; transition: opacity .25s; }
  .pcard:hover { transform: translateY(-6px); border-color: var(--vio); box-shadow: 0 14px 40px rgba(154,92,255,.2); }
  .pcard:hover::after { opacity: 1; }
  .tag { font: 500 12px 'IBM Plex Mono', monospace; letter-spacing: .14em; color: var(--vio); }
  .ico { width: 54px; height: 54px; margin: 26px 0 18px; color: #d9c8ff; }
  .ico svg { width: 100%; height: 100%; }
  .pcard h3 { font-size: 24px; margin: 0 0 8px; }
  .cta { margin-top: 36px; }
  #splash small { font-family: 'IBM Plex Mono', monospace; }
  #bgc { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; cursor: default; }
  #splash > img, #splash > p, #splash > button { position: relative; z-index: 1; }
  .storygrid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.25fr); gap: 5vw; margin-top: 40px; align-items: start; }
  .storygrid figure { margin: 0; position: sticky; top: 90px; isolation: isolate; }
  .storygrid figure::before { content: ''; position: absolute; inset: -12%; z-index: -1; border-radius: 50%; background: radial-gradient(closest-side, rgba(154,92,255,.75), rgba(154,92,255,0) 72%); filter: blur(34px); animation: aura 4.5s ease-in-out infinite; }
  @keyframes aura { 50% { opacity: .55; transform: scale(1.06); } }
  @media (prefers-reduced-motion: reduce) { .storygrid figure::before { animation: none; } }
  .storygrid img { width: 100%; height: auto; display: block; border-radius: 24px; border: 1px solid rgba(154,92,255,.7); box-shadow: 0 0 0 6px rgba(154,92,255,.12), 0 0 50px rgba(154,92,255,.5); }
  .item { display: flex; gap: 22px; align-items: flex-start; padding: 26px; margin-bottom: 14px; border: 1px solid var(--line); border-radius: 22px; background: linear-gradient(160deg, #241a42, #14111f); transition: transform .25s, border-color .25s, box-shadow .25s; }
  .item:hover { transform: translateX(8px); border-color: var(--vio); box-shadow: 0 10px 36px rgba(154,92,255,.22); }
  .ico2 { flex: 0 0 60px; width: 60px; height: 60px; border-radius: 18px; display: grid; place-items: center; color: #efe6ff; background: radial-gradient(circle at 30% 25%, rgba(154,92,255,.65), rgba(154,92,255,.12)); box-shadow: 0 0 26px rgba(154,92,255,.5); }
  .ico2 svg { width: 32px; height: 32px; }
  .item h3 { font-size: 24px; margin: 8px 0; }
  .item p { margin: 0; color: var(--mute); }
  @media (max-width: 820px) { .storygrid { grid-template-columns: 1fr; } .storygrid figure { position: static; } }
  footer .fl { color: var(--mute); margin-left: 14px; }
  .faq { margin-top: 30px; max-width: 70ch; }
  details { border-bottom: 1px solid var(--line); padding: 16px 0; }
  summary { cursor: pointer; font-weight: 500; }
  details p, .more { color: var(--mute); margin: 10px 0 0; }
  .soon p { color: var(--mute); max-width: 52ch; margin: 18px 0 26px; }
  footer { padding: 40px 5vw; color: var(--mute); font-size: 14px; border-top: 1px solid var(--line); }
  @media (max-width: 820px) { .hero { grid-template-columns: 1fr; min-height: 0; } .l { display: none; } }
</style>

<script>
  const cv = document.getElementById('c') as HTMLCanvasElement;
  const x = cv.getContext('2d')!;
  const T = JSON.parse((document.getElementById('stage') as HTMLElement).dataset.t!);
  const info = document.getElementById('info')!, st = document.getElementById('st')!;
  const still = matchMedia('(prefers-reduced-motion:reduce)').matches;
  let W = 0, H = 0, tick = 0, sel: any = null, drag: any = null, dragC = -1, fstate = 'fc';
  const F = [[.27, .3], [.74, .26], [.78, .72], [.24, .7]];
  const G: any[] = [1, 2, 3, 4, 5].map((i) => ({ n: 'goat-00' + i, x: .5 + Math.cos(i * 1.25) * .1, y: .5 + Math.sin(i * 1.25) * .1, vx: (Math.random() - .5) * .0016, vy: (Math.random() - .5) * .0016, bat: i == 3 ? 9 : 40 + i * 11, acc: [2, 8, 5, 34, 12][i - 1], out: false, trail: [] }));
  function size() { const d = Math.min(devicePixelRatio || 1, 2); W = cv.clientWidth; H = cv.clientHeight; if (!W || !H) return; cv.width = W * d; cv.height = H * d; x.setTransform(d, 0, 0, d, 0, 0); }
  addEventListener('resize', size);
  new ResizeObserver(size).observe(cv.parentElement as HTMLElement);
  function inside(px: number, py: number) {
    let c = false;
    for (let i = 0, j = 3; i < 4; j = i++) {
      const [xi, yi] = F[i], [xj, yj] = F[j];
      if ((yi > py) !== (yj > py) && px < (xj - xi) * (py - yi) / (yj - yi) + xi) c = !c;
    }
    return c;
  }
  function show() {
    info.textContent = !sel ? T.inf : `${sel.n} · ${T.bat} ${sel.bat}%` + (sel.bat < 15 ? ` · ${T.low}` : '') + ` · ±${sel.acc} m`;
  }
  function draw() {
    tick++; x.clearRect(0, 0, W, H);
    x.strokeStyle = 'rgba(154,92,255,.1)'; x.lineWidth = 1;
    for (let i = 0; i < W; i += 40) { x.beginPath(); x.moveTo(i, 0); x.lineTo(i, H); x.stroke(); }
    for (let i = 0; i < H; i += 40) { x.beginPath(); x.moveTo(0, i); x.lineTo(W, i); x.stroke(); }
    x.beginPath(); F.forEach(([a, b], i) => (i ? x.lineTo(a * W, b * H) : x.moveTo(a * W, b * H))); x.closePath();
    x.fillStyle = 'rgba(154,92,255,.10)'; x.fill();
    x.strokeStyle = '#c9b0ff'; x.lineWidth = fstate == 'fq' ? 1.2 : fstate == 'fs' ? 2 : 3;
    x.setLineDash(fstate == 'fc' ? [] : [10, 8]); x.lineDashOffset = -tick * .4; x.stroke(); x.setLineDash([]);
    G.forEach((g) => {
      if (!still && g !== drag) {
        g.x += g.vx; g.y += g.vy;
        if (Math.random() < .01) { g.vx = (Math.random() - .5) * .0016; g.vy = (Math.random() - .5) * .0016; }
        if (!g.out && !inside(g.x + g.vx * 6, g.y + g.vy * 6)) { g.vx *= -1; g.vy *= -1; }
        if (g.out) { g.vx = (.5 - g.x) * .0006; g.vy = (.5 - g.y) * .0006; }
      }
      const o = !inside(g.x, g.y);
      if (o && !g.out) st.textContent = T.out.replace('%n', g.n);
      if (!o && g.out) st.textContent = T.in;
      g.out = o;
      if (tick % 14 === 0) { g.trail.push([g.x, g.y]); if (g.trail.length > 12) g.trail.shift(); }
      const c = o ? '#ffffff' : g.bat < 15 ? '#ff8a8a' : '#9a5cff', p = g.x * W, q = g.y * H;
      x.strokeStyle = c + '66'; x.lineWidth = 1; x.beginPath();
      g.trail.forEach(([a, b]: number[], k: number) => (k ? x.lineTo(a * W, b * H) : x.moveTo(a * W, b * H))); x.lineTo(p, q); x.stroke();
      g.trail.forEach(([a, b]: number[]) => { x.fillStyle = c + '99'; x.beginPath(); x.arc(a * W, b * H, 2, 0, 7); x.fill(); });
      const r = 8 + g.acc * .7;
      x.fillStyle = c + '22'; x.strokeStyle = c + '66'; x.lineWidth = 1; x.beginPath(); x.arc(p, q, r, 0, 7); x.fill(); x.stroke();
      if (o || g.bat < 15) { x.strokeStyle = c + '55'; x.lineWidth = 2; x.beginPath(); x.arc(p, q, r + 6 + Math.sin(tick / 8) * 5, 0, 7); x.stroke(); }
      x.fillStyle = c; x.beginPath(); x.arc(p, q, 6, 0, 7); x.fill();
      if (g === sel) { x.strokeStyle = '#fff'; x.lineWidth = 2; x.stroke(); }
      x.fillStyle = '#f3f0fa'; x.font = '12px Archivo'; x.fillText(g.n, p + 13, q - 11);
    });
    F.forEach(([a, b]) => { x.fillStyle = '#fff'; x.strokeStyle = '#9a5cff'; x.lineWidth = 2; x.fillRect(a * W - 6, b * H - 6, 12, 12); x.strokeRect(a * W - 6, b * H - 6, 12, 12); });
    show(); requestAnimationFrame(draw);
  }
  const pos = (e: PointerEvent) => { const r = cv.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
  cv.onpointerdown = (e) => {
    const [mx, my] = pos(e);
    dragC = F.findIndex(([a, b]) => Math.hypot(a * W - mx, b * H - my) < 22);
    if (dragC >= 0) { cv.setPointerCapture(e.pointerId); return; }
    let best: any = null, bd = 34;
    G.forEach((g) => { const d = Math.hypot(g.x * W - mx, g.y * H - my); if (d < bd) { bd = d; best = g; } });
    sel = best; drag = best; if (best) cv.setPointerCapture(e.pointerId);
  };
  cv.onpointermove = (e) => {
    const [mx, my] = pos(e);
    if (dragC >= 0) { F[dragC] = [Math.min(.95, Math.max(.05, mx / W)), Math.min(.95, Math.max(.05, my / H))]; fstate = 'fq'; st.textContent = T.fq; }
    else if (drag) { drag.x = mx / W; drag.y = my / H; }
  };
  cv.addEventListener('touchstart', (e) => {
    const t = e.touches[0], r = cv.getBoundingClientRect(), mx = t.clientX - r.left, my = t.clientY - r.top;
    const hit = F.some(([a, b]) => Math.hypot(a * W - mx, b * H - my) < 22) || G.some((g) => Math.hypot(g.x * W - mx, g.y * H - my) < 34);
    if (hit) e.preventDefault();
  }, { passive: false });
  cv.onpointerup = () => {
    if (dragC >= 0) { dragC = -1; setTimeout(() => { fstate = 'fs'; st.textContent = T.fs; }, 900); setTimeout(() => { fstate = 'fc'; st.textContent = T.fc; }, 1800); }
    drag = null;
  };
  size(); st.textContent = T.fc; draw();
</script>

<script>
  const sp = document.getElementById('splash')!;
  try { if (sessionStorage.getItem('oft-enter')) sp.remove(); } catch {}
  document.getElementById('enter')?.addEventListener('click', () => {
    try { sessionStorage.setItem('oft-enter', '1'); } catch {}
    sp.classList.add('gone'); setTimeout(() => sp.remove(), 600);
  });
</script>

<script>
  const flow = document.getElementById('flow')!;
  const S = JSON.parse(flow.dataset.s!);
  const nodes = [...flow.querySelectorAll('.node')] as HTMLElement[];
  const dot = document.getElementById('dot')!, cap = document.getElementById('cap')!, play = document.getElementById('play') as HTMLButtonElement;
  const at = [0, 50, 100];
  function pick(i: number) { nodes.forEach((n, k) => n.classList.toggle('on', k === i)); cap.textContent = S[i][1]; dot.style.left = at[i] + '%'; }
  nodes.forEach((n, i) => n.addEventListener('click', () => pick(i)));
  play.addEventListener('click', async () => {
    play.disabled = true;
    for (let i = 0; i < 3; i++) { pick(i); await new Promise((r) => setTimeout(r, 1400)); }
    play.disabled = false;
  });
  pick(0);
</script>

<script>
  document.querySelectorAll<HTMLElement>('.pcard').forEach((c) => c.addEventListener('pointermove', (e) => {
    const r = c.getBoundingClientRect(); c.style.setProperty('--x', e.clientX - r.left + 'px'); c.style.setProperty('--y', e.clientY - r.top + 'px');
  }));
</script>

<script>
  const bg = document.getElementById('bgc') as HTMLCanvasElement | null;
  if (bg) {
    const g = bg.getContext('2d')!;
    const calm = matchMedia('(prefers-reduced-motion:reduce)').matches;
    type P = { x: number; y: number; vx: number; vy: number };
    let w = 0, h = 0, mx = -1e4, my = -1e4, t = 0, ps: P[] = [];
    const rings: number[] = [0];
    function fit() {
      const d = devicePixelRatio || 1; w = bg!.clientWidth; h = bg!.clientHeight;
      bg!.width = w * d; bg!.height = h * d; g.setTransform(d, 0, 0, d, 0, 0);
      ps = Array.from({ length: w < 600 ? 24 : 46 }, () => ({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - .5) * .35, vy: (Math.random() - .5) * .35 }));
    }
    addEventListener('resize', fit); fit();
    bg.parentElement!.addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; });
    function frame() {
      t++; g.clearRect(0, 0, w, h);
      if (!calm && t % 160 === 0) rings.push(t);
      for (let i = rings.length - 1; i >= 0; i--) {
        const a = (t - rings[i]) / 280;
        if (a > 1) { rings.splice(i, 1); continue; }
        g.strokeStyle = `rgba(154,92,255,${.38 * (1 - a)})`; g.lineWidth = 2;
        g.beginPath(); g.arc(w / 2, h * .42, a * Math.max(w, h) * .6, 0, 7); g.stroke();
      }
      if (!calm) ps.forEach((p) => {
        p.x += p.vx; p.y += p.vy;
        const dx = p.x - mx, dy = p.y - my, d = Math.hypot(dx, dy);
        if (d < 120 && d > 0) { p.x += dx / d * .8; p.y += dy / d * .8; }
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
      });
      for (let i = 0; i < ps.length; i++) for (let j = i + 1; j < ps.length; j++) {
        const a = ps[i], b = ps[j], d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < 150) { g.strokeStyle = `rgba(154,92,255,${.28 * (1 - d / 150)})`; g.lineWidth = 1; g.beginPath(); g.moveTo(a.x, a.y); g.lineTo(b.x, b.y); g.stroke(); }
      }
      g.fillStyle = 'rgba(201,176,255,.85)';
      ps.forEach((p) => { g.beginPath(); g.arc(p.x, p.y, 2, 0, 7); g.fill(); });
      if (bg!.isConnected) requestAnimationFrame(frame);
    }
    frame();
  }
</script>
